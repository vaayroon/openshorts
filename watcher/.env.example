# Stream watcher settings. Copy to watcher/.env (git-ignored):
#   cp watcher/.env.example watcher/.env
#
# To start the watcher with the rest of the stack, also add this line to the
# ROOT .env (Compose reads COMPOSE_FILE only from there, not from this file):
#   COMPOSE_FILE=docker-compose.yml:docker-compose.override.yml:docker-compose.watcher.yml

# Gemini key for the jobs the watcher submits, sent as X-Gemini-Key. The key
# you saved in the dashboard lives in your browser, which the watcher cannot
# reach. Leave empty only if the backend has GEMINI_API_KEY in its own env.
GEMINI_API_KEY=

# Seconds between runs (default 1800 = 30 minutes).
WATCHER_INTERVAL_SECONDS=1800
